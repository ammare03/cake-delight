# Java / Maven
target/
*.class
*.jar
*.war
*.log
*.stackdump
.mvn/
mvnw
mvnw.cmd
!**/src/main/**/target/
!**/src/test/**/target/
# Spring Initializr per-module boilerplate — monorepo uses this root .gitignore instead
HELP.md
.gitattributes
!/.gitattributes

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Node / Next.js — same "monorepo uses this root .gitignore instead" reasoning
# as the Spring Initializr boilerplate above; frontend-service's own
# create-next-app-generated .gitignore was deleted in favor of this.
node_modules/
.next/
out/
.env.local
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# Env / secrets
.env
.env.production
*.pem
*.key

# Docker
*.pid

# Local overrides
application-local.properties
config-repo/*-local.properties

# Claude Code project files
CLAUDE.md
.claude/

# Audit reports — local only, not committed. Narrower than docs/ itself:
# graded deliverables (DL-2/DL-5/DL-6/DL-8 docs) belong in docs/ and must
# be committed; only docs/audits/ is progress-tracking noise.
docs/audits/

# Local-only project reference docs — kept on disk for local use, not
# committed to the repo.
DECISIONS.md
FLOW.md
docs/services/
